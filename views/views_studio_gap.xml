<?xml version="1.0" encoding="utf-8"?>
<!-- BugFix-Studio-Misc: 4 real Studio views (non-qweb gap closeout) -->
<odoo>
  <data>
    <record id="view_x_customer_group_form_studio_ext" model="ir.ui.view">
      <field name="name">Odoo Studio: Default form view for x_customer_group customization</field>
      <field name="model">x_customer_group</field>
      <field name="type">form</field>
      <field name="priority">99</field>
      <field name="inherit_id" ref="studio_usermodel_migration.view_3114_default_form_view_for_x_customer_group_e"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//widget[@name='web_ribbon']" position="before">
    <div name="button_box" class="oe_button_box">
      <button class="oe_stat_button" icon="fa-sitemap" type="action" name="1447" invisible="x_x_studio_customer_group__res_partner_count == 0">
        <field widget="statinfo" name="x_x_studio_customer_group__res_partner_count" string="Customers"/>
      </button>
    </div>
  </xpath>
  <xpath expr="//field[@name='x_name']" position="attributes">
    <attribute name="string">Code</attribute>
  </xpath>
  <xpath expr="//group[@name='studio_group_36e52f_left']" position="inside">
    <field name="x_studio_description" string="Description"/>
    <field name="x_studio_payment_term" string="Payment Term" required="1"/>
    <field name="x_studio_receivable_account" string="Receivable Account" required="1"/>
    <field name="x_studio_group_type" string="Group Type" required="1"/>
    <field name="x_studio_company_id" string="Company" force_save="True" readonly="1"/>
  </xpath>
  <xpath expr="//group[@name='studio_group_36e52f']" position="after">
    <notebook name="studio_notebook_NLBUK">
      <page string="Linked Customers" name="studio_page_NLBUK" invisible="x_x_studio_customer_group__res_partner_count == 0">
        <field name="x_studio_one2many_field_hfDGm" string="Customers">
          <tree string="Contacts" sample="1" multi_edit="1" create="false" delete="false" edit="false">
            <field name="name"/>
            <field name="x_studio_payment_method"/>
            <field name="credit"/>
          </tree>
        </field>
      </page>
    </notebook>
  </xpath>
</data>
      </field>
    </record>

    <record id="view_project_task_studio_cohort" model="ir.ui.view">
      <field name="name">Default cohort view for project.task</field>
      <field name="model">project.task</field>
      <field name="type">cohort</field>
      <field name="arch" type="xml">
        <cohort date_start="date_assign" date_stop="date_assign" string="Default cohort view for project.task"/>
      </field>
    </record>

  </data>
</odoo>