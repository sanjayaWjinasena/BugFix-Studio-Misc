<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_2587_default_form_view_for_x_product_test" model="ir.ui.view">
      <field name="name">Default form view for x_product_test</field>
      <field name="model">x_product_test</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form>
  <header/>
  <sheet string="product.test">
    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
    <field name="x_active" invisible="1"/>
    <div class="oe_title">
                <h1>
                    <field name="x_name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_2ae04f">
      <group name="studio_group_2ae04f_left"/>
      <group name="studio_group_2ae04f_right"/>
    </group>
  </sheet>
  <div class="oe_chatter" name="oe_chatter">
    <!-- STRIPPED field message_follower_ids not on model x_product_test -->
    <!-- STRIPPED field message_ids not on model x_product_test -->
    <!-- STRIPPED field activity_ids not on model x_product_test -->
  </div>
</form>
      </field>
    </record>
    <record id="view_2586_default_list_view_for_x_product_test" model="ir.ui.view">
      <field name="name">Default list view for x_product_test</field>
      <field name="model">x_product_test</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree>
  <field name="x_studio_sequence" widget="handle"/>
  <field name="x_name"/>
</tree>
      </field>
    </record>
    <record id="view_2588_default_search_view_for_x_product_test" model="ir.ui.view">
      <field name="name">Default search view for x_product_test</field>
      <field name="model">x_product_test</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="x_name"/>
  <separator/>
  <filter string="Archived" name="archived_x_product_test" domain="[['x_active', '=', False]]"/>
  <separator/>
</search>
      </field>
    </record>
    <record id="view_2589_odoo_studio_default_form_view_for_x_product_test_customizati_ext" model="ir.ui.view">
      <field name="name">Odoo Studio: Default form view for x_product_test customization</field>
      <field name="model">x_product_test</field>
      <field name="type">form</field>
      <field name="inherit_id" ref="BugFix-Studio-Misc.view_2587_default_form_view_for_x_product_test"/>
      <field name="mode">extension</field>
      <field name="priority">99</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//field[@name='x_name']" position="attributes">
    <attribute name="required"/></xpath>
  <xpath expr="//group[@name='studio_group_2ae04f_left']" position="inside">
    <field name="x_studio_many2one_field_cmfRx"/>
    <field name="x_studio_product_1" string="Product_1"/>
  </xpath>
  <xpath expr="//group[@name='studio_group_2ae04f_right']" position="inside">
    <field widget="many2many_tags" name="x_studio_many2many_field_R1u9s"/>
  </xpath>
</data>
      </field>
    </record>
    <record id="view_2590_odoo_studio_default_list_view_for_x_product_test_customizati_ext" model="ir.ui.view">
      <field name="name">Odoo Studio: Default list view for x_product_test customization</field>
      <field name="model">x_product_test</field>
      <field name="type">tree</field>
      <field name="inherit_id" ref="BugFix-Studio-Misc.view_2586_default_list_view_for_x_product_test"/>
      <field name="mode">extension</field>
      <field name="priority">99</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//field[@name='x_name']" position="after">
    <field name="x_studio_many2one_field_wTxgi"/>
    <field name="x_studio_journal_name" string="Journal Name"/>
    <field name="x_studio_stock_move"/>
    <field name="x_studio_many2one_field_cmfRx"/>
    <field name="x_studio_product_1"/>
  </xpath>
</data>
      </field>
    </record>
  <record id="act_window_1139_product_test" model="ir.actions.act_window">
    <field name="name">product.test</field>
    <field name="res_model">x_product_test</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
