<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_sales_report" model="ir.actions.act_window">
    <field name="name">Sales Report</field>
    <field name="res_model">bve.salesreport</field>
    <field name="view_mode">tree,graph,pivot</field>
    <field name="context">{'service_name': 'Sales Report'}</field>
  </record>
    <record id="view_graph_analysis" model="ir.ui.view">
      <field name="name">Graph Analysis</field>
      <field name="model">bve.salesreport</field>
      <field name="type">graph</field>
      <field name="arch" type="xml">
        <graph string="Graph Analysis" type="bar" stacked="True">
                        <field name="bve_t1_currency_id" type="row"/><field name="bve_t1_invoice_status" type="row"/><field name="bve_t1_pricelist_id" type="row"/><field name="bve_t1_user_id" type="row"/><field name="bve_t1_warehouse_id" type="row"/><field name="bve_t1_total" type="row"/><field name="bve_t2_product_id" type="row"/>
                       </graph>
      </field>
    </record>
    <record id="view_pivot_analysis" model="ir.ui.view">
      <field name="name">Pivot Analysis</field>
      <field name="model">bve.salesreport</field>
      <field name="type">pivot</field>
      <field name="arch" type="xml">
        <pivot string="Pivot Analysis">
                       <field name="bve_t1_currency_id" type="row"/><field name="bve_t1_invoice_status" type="row"/><field name="bve_t1_pricelist_id" type="row"/><field name="bve_t1_user_id" type="row"/><field name="bve_t1_warehouse_id" type="row"/><field name="bve_t1_total" type="row"/><field name="bve_t2_product_id" type="row"/>
                       </pivot>
      </field>
    </record>
    <record id="view_search_bi_view" model="ir.ui.view">
      <field name="name">Search BI View</field>
      <field name="model">bve.salesreport</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
                       <field name="bve_t1_currency_id" type="row"/><field name="bve_t1_invoice_status" type="row"/><field name="bve_t1_pricelist_id" type="row"/><field name="bve_t1_user_id" type="row"/><field name="bve_t1_warehouse_id" type="row"/><field name="bve_t1_total" type="row"/><field name="bve_t2_product_id" type="row"/>
                       </search>
      </field>
    </record>
    <record id="view_tree_analysis" model="ir.ui.view">
      <field name="name">Tree Analysis</field>
      <field name="model">bve.salesreport</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree create="false">
                       <field name="bve_t1_partner_id" sum="Customer"/><field name="bve_t1_currency_id" sum="Currency"/><field name="bve_t1_customer_credit_limit"/><field name="bve_t1_invoice_status" sum="Invoice Status"/><field name="bve_t1_pricelist_id" sum="Pricelist"/><field name="bve_t1_team_id" sum="Sales Team"/><field name="bve_t1_user_id" sum="Salesperson"/><field name="bve_t1_warehouse_id" sum="Warehouse"/><field name="bve_t1_total" sum="Total"/><field name="bve_t2_product_id" sum="Product"/><field name="bve_t2_qty_delivered" sum="Delivery Quantity"/><field name="bve_t2_product_uom_qty" sum="Quantity"/>
                       </tree>
      </field>
    </record>
</odoo>
