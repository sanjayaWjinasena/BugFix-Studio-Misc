<?xml version="1.0" encoding="utf-8"?>
<!-- upgrade-testing: x_test02 "Move to Second" button. Clear-DB used numeric action 1575; the server action
     (data/server_actions_gap.xml) loads after views/x_test02_views.xml, so the button is added here. -->
<odoo>
  <record id="view_2414_x_test02_move_to_second_button" model="ir.ui.view">
    <field name="name">x_test02 form: Move to Second button</field>
    <field name="model">x_test02</field>
    <field name="inherit_id" ref="BugFix-Studio-Misc.view_2414_default_form_view_for_x_test02"/>
    <field name="arch" type="xml">
      <xpath expr="//header[1]" position="inside">
        <button type="action" name="%(BugFix-Studio-Misc.server_action_1575_update_status)d" string="Move to Second" class="btn-primary" invisible="x_studio_status == 'S2'"/>
      </xpath>
    </field>
  </record>
</odoo>
