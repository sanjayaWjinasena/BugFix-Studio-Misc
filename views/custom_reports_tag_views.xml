<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_jinasena_custom_reports_tags" model="ir.actions.act_window">
    <field name="name">Jinasena Custom Reports Tags</field>
    <field name="res_model">custom_reports_tag</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_custom_reports_tag_form" model="ir.ui.view">
      <field name="name">Default form view for custom_reports_tag</field>
      <field name="model">custom_reports_tag</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form>
  <header/>
  <sheet string="Custom Reports Tags">
    <div class="oe_title">
                <h1>
                    <field name="name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_3dda3f">
      <group name="studio_group_3dda3f_left"/>
      <group name="studio_group_3dda3f_right"/>
    </group>
  </sheet>
</form>
      </field>
    </record>
    <record id="view_custom_reports_tag_list" model="ir.ui.view">
      <field name="name">Default list view for custom_reports_tag</field>
      <field name="model">custom_reports_tag</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree editable="bottom">
  <field name="name"/>
  <field name="color" widget="color_picker"/>
</tree>
      </field>
    </record>
    <record id="view_custom_reports_tag_search" model="ir.ui.view">
      <field name="name">Default search view for custom_reports_tag</field>
      <field name="model">custom_reports_tag</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="name"/>
</search>
      </field>
    </record>
</odoo>
