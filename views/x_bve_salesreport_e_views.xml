<?xml version="1.0" encoding="utf-8"?>
<!-- BugFix-Studio-Misc: Phase E - 4 views for x_bve.salesreport -->
<odoo>
  <data>
    <record id="view_9388_graph_analysis_e" model="ir.ui.view">
      <field name="name">Graph Analysis</field>
      <field name="model">x_bve.salesreport</field>
      <field name="type">graph</field>
      <field name="arch" type="xml">
        <graph string="Graph Analysis" type="bar" stacked="True">
                        <field name="x_bve_t1_currency_id" type="row"/><field name="x_bve_t1_invoice_status" type="row"/><field name="x_bve_t1_pricelist_id" type="row"/><field name="x_bve_t1_user_id" type="row"/><field name="x_bve_t1_warehouse_id" type="row"/><field name="x_bve_t1_x_studio_total" type="row"/><field name="x_bve_t2_product_id" type="row"/>
                       </graph>
      </field>
    </record>

    <record id="view_9387_pivot_analysis_e" model="ir.ui.view">
      <field name="name">Pivot Analysis</field>
      <field name="model">x_bve.salesreport</field>
      <field name="type">pivot</field>
      <field name="arch" type="xml">
        <pivot string="Pivot Analysis">
                       <field name="x_bve_t1_currency_id" type="row"/><field name="x_bve_t1_invoice_status" type="row"/><field name="x_bve_t1_pricelist_id" type="row"/><field name="x_bve_t1_user_id" type="row"/><field name="x_bve_t1_warehouse_id" type="row"/><field name="x_bve_t1_x_studio_total" type="row"/><field name="x_bve_t2_product_id" type="row"/>
                       </pivot>
      </field>
    </record>

    <record id="view_9389_search_bi_view_e" model="ir.ui.view">
      <field name="name">Search BI View</field>
      <field name="model">x_bve.salesreport</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
                       <field name="x_bve_t1_currency_id" type="row"/><field name="x_bve_t1_invoice_status" type="row"/><field name="x_bve_t1_pricelist_id" type="row"/><field name="x_bve_t1_user_id" type="row"/><field name="x_bve_t1_warehouse_id" type="row"/><field name="x_bve_t1_x_studio_total" type="row"/><field name="x_bve_t2_product_id" type="row"/>
