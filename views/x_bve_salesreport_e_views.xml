      </field>
    </record>

    <record id="view_9390_tree_analysis_e" model="ir.ui.view">
      <field name="name">Tree Analysis</field>
      <field name="model">x_bve.salesreport</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree create="false">
                       <field name="x_bve_t1_partner_id" sum="Customer"/><field name="x_bve_t1_currency_id" sum="Currency"/><field name="x_bve_t1_x_studio_customer_credit_limit"/><field name="x_bve_t1_invoice_status" sum="Invoice Status"/><field name="x_bve_t1_pricelist_id" sum="Pricelist"/><field name="x_bve_t1_team_id" sum="Sales Team"/><field name="x_bve_t1_user_id" sum="Salesperson"/><field name="x_bve_t1_warehouse_id" sum="Warehouse"/><field name="x_bve_t1_x_studio_total" sum="Total"/><field name="x_bve_t2_product_id" sum="Product"/><field name="x_bve_t2_qty_delivered" sum="Delivery Quantity"/><field name="x_bve_t2_product_uom_qty" sum="Quantity"/>
