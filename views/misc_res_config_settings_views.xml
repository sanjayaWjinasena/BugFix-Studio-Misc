<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_config_settings" model="ir.actions.act_window">
    <field name="name">config.settings</field>
    <field name="res_model">misc_res_config_settings</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_misc_res_config_settings_form" model="ir.ui.view">
      <field name="name">Default form view for misc_res_config_settings</field>
      <field name="model">misc_res_config_settings</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form>
  <header/>
  <sheet string="res.config.settings">
    <div class="oe_title">
                <h1>
                    <field name="name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_8804bd">
      <group name="studio_group_8804bd_left"/>
      <group name="studio_group_8804bd_right"/>
    </group>
  </sheet>
</form>
      </field>
    </record>
    <record id="view_misc_res_config_settings_list" model="ir.ui.view">
      <field name="name">Default list view for misc_res_config_settings</field>
      <field name="model">misc_res_config_settings</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree>
  <field name="name"/>
</tree>
      </field>
    </record>
    <record id="view_misc_res_config_settings_search" model="ir.ui.view">
      <field name="name">Default search view for misc_res_config_settings</field>
      <field name="model">misc_res_config_settings</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="name"/>
</search>
      </field>
    </record>
    <record id="view_default_form_view_for_misc_res_config_settings_inherit" model="ir.ui.view">
      <field name="name">Odoo Studio: Default form view for misc_res_config_settings customization</field>
      <field name="model">misc_res_config_settings</field>
      <field name="type">form</field>
      <field name="priority">99</field>
      <field name="inherit_id" ref="BugFix-Studio-Misc.view_misc_res_config_settings_form"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//group[@name='studio_group_8804bd_left']" position="inside">
    <field name="minimum_sales_margin_" string="Minimum Sales Margin %"/>
  </xpath>
</data>
      </field>
    </record>
</odoo>
