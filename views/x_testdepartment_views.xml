<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_2394_default_form_view_for_x_testdepartment" model="ir.ui.view">
      <field name="name">Default form view for x_testdepartment</field>
      <field name="model">x_testdepartment</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form>
  <header/>
  <sheet string="TestDepartment">
    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
    <field name="x_active" invisible="1"/>
    <div class="oe_title">
                <h1>
                    <field name="x_name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_5691c0">
      <group name="studio_group_5691c0_left"/>
      <group name="studio_group_5691c0_right"/>
    </group>
  </sheet>
  <div class="oe_chatter" name="oe_chatter">
    <!-- STRIPPED field message_follower_ids not on model x_testdepartment -->
    <!-- STRIPPED field message_ids not on model x_testdepartment -->
    <!-- STRIPPED field activity_ids not on model x_testdepartment -->
  </div>
</form>
      </field>
    </record>
    <record id="view_2393_default_list_view_for_x_testdepartment" model="ir.ui.view">
      <field name="name">Default list view for x_testdepartment</field>
      <field name="model">x_testdepartment</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree>
  <field name="x_studio_sequence" widget="handle"/>
  <field name="x_name"/>
</tree>
      </field>
    </record>
    <record id="view_2395_default_search_view_for_x_testdepartment" model="ir.ui.view">
      <field name="name">Default search view for x_testdepartment</field>
      <field name="model">x_testdepartment</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="x_name"/>
  <separator/>
  <filter string="Archived" name="archived_x_testdepartment" domain="[['x_active', '=', False]]"/>
  <separator/>
</search>
      </field>
    </record>
    <record id="view_2396_odoo_studio_default_form_view_for_x_testdepartment_customiza_ext" model="ir.ui.view">
      <field name="name">Odoo Studio: Default form view for x_testdepartment customization</field>
      <field name="model">x_testdepartment</field>
      <field name="type">form</field>
      <field name="inherit_id" ref="BugFix-Studio-Misc.view_2394_default_form_view_for_x_testdepartment"/>
      <field name="mode">extension</field>
      <field name="priority">99</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//group[@name='studio_group_5691c0_left']" position="inside">
    <field name="x_studio_code" string="Code"/>
    <field name="x_studio_description" string="Description"/>
    <field name="x_Description2" string="Description 2"/>
  </xpath>
  <xpath expr="/form[1]/sheet[1]/group[1]/group[1]/field[1]" position="before">
    <field widget="signature" name="x_studio_sig"/>
  </xpath>
  <xpath expr="/form[1]/sheet[1]/group[1]/group[1]/field[1]" position="attributes">
    <attribute name="string">Sig</attribute>
  </xpath>
  <xpath expr="/form[1]/sheet[1]/group[1]/group[1]/field[1]" position="attributes">
    <attribute name="required">1</attribute></xpath>
  <xpath expr="/form[1]/sheet[1]/group[1]/group[1]/field[1]" position="replace"/>
</data>
      </field>
    </record>
    <record id="view_2397_test_departmet_desc_3_ext" model="ir.ui.view">
      <field name="name">test_departmet_desc_3</field>
      <field name="model">x_testdepartment</field>
      <field name="type">form</field>
      <field name="inherit_id" ref="BugFix-Studio-Misc.view_2394_default_form_view_for_x_testdepartment"/>
      <field name="mode">extension</field>
      <field name="priority">99</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//group[@name='studio_group_5691c0_left']" position="inside">
    <field name="x_Description3" string="Description 3"/>
  </xpath>
</data>
      </field>
    </record>
  <record id="act_window_812_testdepartment" model="ir.actions.act_window">
    <field name="name">TestDepartment</field>
    <field name="res_model">x_testdepartment</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
