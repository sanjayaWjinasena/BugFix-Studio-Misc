<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_x_customer_group_form_studio_ext" model="ir.ui.view">
      <field name="name">Odoo Studio: Default form view for customer_group customization</field>
      <field name="model">customer_group</field>
      <field name="type">form</field>
      <field name="priority">99</field>
      <field name="inherit_id" ref="studio_usermodel_migration.view_3114_default_form_view_for_x_customer_group_e"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//widget[@name='web_ribbon']" position="before">
    <div name="button_box" class="oe_button_box">
      <button class="oe_stat_button" icon="fa-sitemap" type="action" name="%(BugFix-Sales.act_window_1447_customers)d" invisible="customer_group__res_partner_count == 0">
        <field widget="statinfo" name="customer_group__res_partner_count" string="Customers"/>
      </button>
    </div>
  </xpath>
  <xpath expr="//field[@name='name']" position="attributes">
    <attribute name="string">Code</attribute>
  </xpath>
  <xpath expr="//group[@name='studio_group_36e52f_left']" position="inside">
    <field name="description" string="Description"/>
    <field name="payment_term" string="Payment Term" required="1"/>
    <field name="receivable_account" string="Receivable Account" required="1"/>
    <field name="group_type" string="Group Type" required="1"/>
    <field name="accounting_company_id" string="Company" force_save="True" readonly="1"/>
  </xpath>
  <xpath expr="//group[@name='studio_group_36e52f']" position="after">
    <notebook name="studio_notebook_NLBUK">
      <page string="Linked Customers" name="studio_page_NLBUK" invisible="customer_group__res_partner_count == 0">
        <field name="one2many_field_hfDGm" string="Customers">
          <tree string="Contacts" sample="1" multi_edit="1" create="false" delete="false" edit="false">
            <field name="name"/>
            <field name="payment_method"/>
            <field name="credit"/>
          </tree>
        </field>
      </page>
    </notebook>
  </xpath>
</data>
      </field>
    </record>
</odoo>
