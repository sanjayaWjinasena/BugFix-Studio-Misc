<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_sample_balance_movement_report" model="ir.actions.act_window">
    <field name="name">Sample Balance Movement Report</field>
    <field name="res_model">bve.samplebalancemovementreport</field>
    <field name="view_mode">tree,graph,pivot</field>
    <field name="context">{'service_name': 'Sample Balance Movement Report'}</field>
  </record>
    <record id="view_graph_analysis_2" model="ir.ui.view">
      <field name="name">Graph Analysis</field>
      <field name="model">bve.samplebalancemovementreport</field>
      <field name="type">graph</field>
      <field name="arch" type="xml">
        <graph string="Graph Analysis" type="bar" stacked="True">
                        <field name="bve_t1_account_id" type="row"/><field name="bve_t1_date" type="row"/><field name="bve_t1_debit" type="measure"/><field name="bve_t1_credit" type="measure"/><field name="bve_t1_balance" type="measure"/>
                       </graph>
      </field>
    </record>
    <record id="view_pivot_analysis_2" model="ir.ui.view">
      <field name="name">Pivot Analysis</field>
      <field name="model">bve.samplebalancemovementreport</field>
      <field name="type">pivot</field>
      <field name="arch" type="xml">
        <pivot string="Pivot Analysis">
                       <field name="bve_t1_account_id" type="row"/><field name="bve_t1_date" type="row"/><field name="bve_t1_debit" type="measure"/><field name="bve_t1_credit" type="measure"/><field name="bve_t1_balance" type="measure"/>
                       </pivot>
      </field>
    </record>
    <record id="view_search_bi_view_2" model="ir.ui.view">
      <field name="name">Search BI View</field>
      <field name="model">bve.samplebalancemovementreport</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
                       <field name="bve_t1_account_id" type="row"/><field name="bve_t1_date" type="row"/><field name="bve_t1_debit" type="measure"/><field name="bve_t1_credit" type="measure"/><field name="bve_t1_balance" type="measure"/>
                       </search>
      </field>
    </record>
    <record id="view_tree_analysis_2" model="ir.ui.view">
      <field name="name">Tree Analysis</field>
      <field name="model">bve.samplebalancemovementreport</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree create="false">
                       <field name="bve_t1_account_id" sum="Account"/><field name="bve_t1_date" sum="Date"/><field name="bve_t1_debit" sum="Debit"/><field name="bve_t1_credit" sum="Credit"/><field name="bve_t1_balance" sum="Balance"/><field name="bve_t1_company_id" sum="Company"/>
                       </tree>
      </field>
    </record>
</odoo>
