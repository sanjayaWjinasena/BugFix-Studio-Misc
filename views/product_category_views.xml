<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_product_categories_d7" model="ir.actions.act_window">
    <field name="name">Product Categories</field>
    <field name="res_model">product.category</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_product_category_list_inherit" model="ir.ui.view">
      <field name="name">Odoo Studio: product.category.list customization</field>
      <field name="model">product.category</field>
      <field name="type">tree</field>
      <field name="mode">extension</field>
      <field name="inherit_id" ref="product.product_category_list_view"/>
      <field name="priority" eval="99"/>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//field[@name='display_name']" position="after">
    <field name="accounting_company_id" optional="show"/>
    <field optional="show" name="description" string="Description"/>
    <field name="id" optional="show"/>
  </xpath>
</data>
      </field>
    </record>
    <record id="view_product_category_form_inherit" model="ir.ui.view">
      <field name="name">Odoo Studio: product.category.form customization</field>
      <field name="model">product.category</field>
      <field name="type">form</field>
      <field name="mode">extension</field>
      <field name="inherit_id" ref="product.product_category_form_view"/>
      <field name="priority" eval="160"/>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//field[@name='parent_id']" position="before">
    <field name="description"/>
  </xpath>
  <xpath expr="//field[@name='removal_strategy_id']" position="after">
    <field name="accounting_company_id" string="Company"/>
  </xpath>
</data>
      </field>
    </record>
</odoo>
