    <record id="view_std_ir_model_access_2323" model="ir.ui.view">
      <field name="name">Odoo Studio: ir.model.access search customization</field>
      <field name="model">ir.model.access</field>
      <field name="type">search</field>
      <field name="mode">extension</field>
      <field name="inherit_id" ref="base.ir_access_view_search"/>
      <field name="priority" eval="99"/>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//field[@name='group_id']" position="after">
    <field name="name"/>
  </xpath>
</data>
      </field>
    </record>
    <record id="view_std_ir_model_access_5301" model="ir.ui.view">
      <field name="name">Odoo Studio: ir.model.access.view.tree.edition customization</field>
