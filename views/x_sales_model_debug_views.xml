<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="act_window_2380_sales_model_debug" model="ir.actions.act_window">
    <field name="name">Sales Model Debug</field>
    <field name="res_model">x_sales_model_debug</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_5293_default_form_view_for_x_sales_model_debug_e" model="ir.ui.view">
      <field name="name">Default form view for x_sales_model_debug</field>
      <field name="model">x_sales_model_debug</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form>
  <header/>
  <sheet string="Sales Model Debug">
    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
    <field name="x_active" invisible="1"/>
    <div class="oe_title">
                <h1>
                    <field name="x_name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_8d6c04">
      <group name="studio_group_8d6c04_left"/>
      <group name="studio_group_8d6c04_right"/>
    </group>
  </sheet>
  <div class="oe_chatter" name="oe_chatter">
    <field name="message_follower_ids"/>
    <field name="message_ids"/>
    <field name="activity_ids"/>
  </div>
</form>
      </field>
    </record>
    <record id="view_5292_default_list_view_for_x_sales_model_debug_e" model="ir.ui.view">
      <field name="name">Default list view for x_sales_model_debug</field>
      <field name="model">x_sales_model_debug</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree>
  <field name="x_studio_sequence" widget="handle"/>
  <field name="x_name"/>
</tree>
      </field>
    </record>
    <record id="view_5294_default_search_view_for_x_sales_model_debug_e" model="ir.ui.view">
      <field name="name">Default search view for x_sales_model_debug</field>
      <field name="model">x_sales_model_debug</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="x_name"/>
  <separator/>
  <filter string="Archived" name="archived_x_sales_model_debug" domain="[['x_active', '=', False]]"/>
  <separator/>
</search>
      </field>
    </record>
    <record id="view_final_x_sales_model_debug_odoo_studio_default_list_view_for_x_sales_model_debug_custo" model="ir.ui.view">
      <field name="name">Odoo Studio: Default list view for x_sales_model_debug customization</field>
      <field name="model">x_sales_model_debug</field>
      <field name="type">tree</field>
      <field name="priority">99</field>
      <field name="inherit_id" ref="BugFix-Studio-Misc.view_5292_default_list_view_for_x_sales_model_debug_e"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//tree[1]" position="attributes">
    <attribute name="editable">bottom</attribute>
  </xpath>
  <xpath expr="//field[@name='x_name']" position="attributes">
    <attribute name="string">Method Name</attribute>
  </xpath>
  <xpath expr="//field[@name='x_name']" position="after">
    <field optional="show" name="x_studio_start_time" string="Start Time"/>
    <field optional="show" name="x_studio_end_time" string="End Time"/>
  </xpath>
</data>
      </field>
    </record>
</odoo>
