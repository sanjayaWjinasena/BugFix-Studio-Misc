<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ir_rule_form_inherit" model="ir.ui.view">
      <field name="name">Odoo Studio: ir.rule form customization</field>
      <field name="model">ir.rule</field>
      <field name="type">form</field>
      <field name="mode">extension</field>
      <field name="inherit_id" ref="base.view_rule_form"/>
      <field name="priority" eval="99"/>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//field[@name='perm_create']" position="after">
    </xpath>
</data>
      </field>
    </record>
    <record id="view_ir_rule_tree_inherit" model="ir.ui.view">
      <field name="name">Odoo Studio: ir.rule tree customization</field>
      <field name="model">ir.rule</field>
      <field name="type">tree</field>
      <field name="mode">extension</field>
      <field name="inherit_id" ref="base.view_rule_tree"/>
      <field name="priority" eval="99"/>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//field[@name='domain_force']" position="after">
    </xpath>
</data>
      </field>
    </record>
</odoo>
