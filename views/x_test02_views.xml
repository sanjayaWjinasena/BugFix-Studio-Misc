      </field>
    </record>

    <record id="view_2955_default_kanban_view_for_ir_model_782" model="ir.ui.view">
      <field name="name">Default kanban view for ir.model(782,)</field>
      <field name="model">x_test02</field>
      <field name="type">kanban</field>
      <field name="arch" type="xml">
