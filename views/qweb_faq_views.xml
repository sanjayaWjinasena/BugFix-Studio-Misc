<?xml version="1.0" encoding="utf-8"?>
<!-- Studio-Misc: 4 qweb views for x_website_faqs (website frontend) -->
<!-- One duplicate key auto-suffixed with cdb_id for uniqueness -->
<odoo>
  <data>

    <record id="view_8241_qweb_faq" model="ir.ui.view">
      <field name="name">faq</field>
      <field name="key">website_studio.faq-1</field>
      <field name="model">x_website_faqs</field>
      <field name="type">qweb</field>
      <field name="arch" type="xml">
        <t t-name="website_studio.faq-1">
  <t t-call="website.layout">
    <div id="o_website_record_page wrap">
      <div class="oe_structure oe_new" data-editor-message="Drag building blocks to customize the header of single record pages."/>
      <div class="container">
        <ol t-if="listing" class="breadcrumb p-0 my-2">
          <li class="breadcrumb-item o_not_editable">
            <a t-att-href="listing['href']">
              <span t-out="listing['name']"/>
            </a>
          </li>
          <li class="breadcrumb-item active">
            <span t-field="record.display_name"/>
          </li>
        </ol>
        <div class="d-flex flex-row my-4 flex-wrap align-items-center justify-content-between">
          <div class="col-lg-4 mt-lg-4 col-sm-12">
            <h1 class="h1">
              <span t-field="record.display_name"/>
            </h1>
          </div>
        </div>
        <div class="o_website_html" t-field="record.x_studio_website_description" data-editor-message="Drag building blocks to edit the website description of this record."/>
      </div>
      <div class="oe_structure oe_new" data-editor-message="Drag building blocks to customize the footer of single record pages."/>
    </div>
  </t>
</t>
      </field>
    </record>

    <record id="view_8246_qweb_faq" model="ir.ui.view">
      <field name="name">faq</field>
      <field name="key">website_studio.faq</field>
      <field name="model">x_website_faqs</field>
      <field name="type">qweb</field>
      <field name="arch" type="xml">
        <t t-name="website_studio.faq_partial">
    <div class="container o_faq_section">
        <div class="oe_structure oe_new"/>

        <!-- Search Bar Section -->
        <section class="s_searchbar o_colored_level o_cc pt48 pb48">
            <div class="row">
                <div class="col-lg-8 offset-lg-2">
                    <form method="get" class="o_searchbar_form d-flex">
                        <div class="input-group flex-grow-1">
                            <input type="search" name="search" class="form-control oe_search_box text-bg-light border-0" placeholder="Search FAQs..." t-att-value="search" autocomplete="off"/>
                            <button type="submit" class="btn btn-light" title="Search">
                                <i class="oi oi-search"/>
                                <t t-if="search">
                                    <small class="ms-2 text-muted">(<t t-out="search_count or 0"/> found)</small>
                                </t>
                            </button>
                        </div>
                        <input type="hidden" name="order" class="o_search_order_by" t-att-value="order_by if order_by else 'name asc'"/>
                    </form>
                </div>
            </div>
        </section>

        <!-- FAQ List -->
        <section class="o_faq_list my-4" t-attf-class="row #{'o_website_grid' if layout_mode == 'grid' else 'o_website_list'}">
            <t t-foreach="records" t-as="record">
                <div t-attf-class="#{'col-lg-3 col-md-4 col-sm-6' if layout_mode == 'grid' else 'col-12'} mb-3">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title text-primary" t-field="record.x_studio_question"/>
                            <p class="card-text" t-field="record.x_studio_answer"/>
                        </div>
                    </div>
                </div>
            </t>
        </section>

        <!-- Pagination -->
        <div t-if="pager" class="o_portal_pager d-flex justify-content-center my-4">
            <t t-call="portal.pager"/>
        </div>
    </div>
</t>
      </field>
    </record>

    <record id="view_8247_qweb_faq" model="ir.ui.view">
      <field name="name">faq</field>
      <field name="key">website_studio.faq-2</field>
      <field name="model">x_website_faqs</field>
      <field name="type">qweb</field>
      <field name="arch" type="xml">
        <t t-name="website_studio.faq-2">
  <t t-call="website.layout">
    <div class="container o_website_listing_layout">
      <div class="oe_structure oe_new"/>
      <section class="s_searchbar o_colored_level o_cc pt48 pb48">
        <div class="row">
          <div class="col-lg-8 offset-lg-2">
            <div class="btn-toolbar">
              <form method="get" class="o_searchbar_form s_searchbar_input me-auto flex-grow-1">
                <div role="search" class="input-group">
                  <input type="search" name="search" class="search-query form-control oe_search_box border-0 text-bg-light" placeholder="Search..." t-att-value="search" autocomplete="off"/>
                  <button type="submit" aria-label="Search" title="Search" class="btn oe_search_button btn-light">
                    <i class="oi oi-search"/>
                    <span t-if="search" class="oe_search_found">
                      <small>(<t t-out="search_count or 0"/> found)</small>
                    </span>
                  </button>
                </div>
                <input name="order" type="hidden" class="o_search_order_by" t-att-value="order_by if order_by else 'name asc'"/>
              </form>
              <t t-call="website_studio.listing_layout_switcher"/>
            </div>
          </div>
        </div>
      </section>
      <div t-attf-class="row mx-n2 mt8 #{'o_website_grid' if layout_mode == 'grid' else 'o_website_list'}">
        <t t-foreach="records" t-as="record">
          <div t-attf-class="#{'col-lg-3 col-md-4 col-sm-6 px-2 col-xs-12' if layout_mode == 'grid' else ''}">
            <a class="o_website_record text-decoration-none d-grid card w-100 mb-3" t-att-href="record_to_url(record)">
              <div class="d-flex"/>
              <div class="card-body py-2 px-3">
                <h5 class="card-title">
                  <span t-field="record.display_name"/>
                </h5>
                <div class="card-text d-flex flex-column flex-grow-1 mt-1">
                  <span class="mb-0"/>
                </div>
              </div>
            </a>
          </div>
        </t>
      </div>
      <div class="oe_structure oe_new"/>
      <div t-if="pager" class="o_portal_pager d-flex justify-content-center my-4">
        <t t-call="portal.pager"/>
      </div>
    </div>
  </t>
</t>
      </field>
    </record>

    <record id="view_8248_qweb_faq" model="ir.ui.view">
      <field name="name">faq</field>
      <field name="key">website_studio.faq-2-8248</field>
      <field name="model">x_website_faqs</field>
      <field name="type">qweb</field>
      <field name="arch" type="xml">
        <t t-name="website_studio.faq">
    <t t-call="website.layout">
        <div class="container o_faq_section">
            <div class="oe_structure oe_new"/>

            <!-- Search Bar Section -->
            <section class="s_searchbar o_colored_level o_cc pt48 pb48">
                <div class="row">
                    <div class="col-lg-8 offset-lg-2">
                        <form method="get" class="o_searchbar_form d-flex">
                            <div class="input-group flex-grow-1">
                                <input type="search" name="search" class="form-control oe_search_box text-bg-light border-0" placeholder="Search FAQs..." t-att-value="search" autocomplete="off"/>
                                <button type="submit" class="btn btn-light" title="Search">
                                    <i class="oi oi-search"/>
                                    <t t-if="search">
                                        <small class="ms-2 text-muted">(<t t-out="search_count or 0"/> found)</small>
                                    </t>
                                </button>
                            </div>
                            <input type="hidden" name="order" class="o_search_order_by" t-att-value="order_by if order_by else 'name asc'"/>
                        </form>
                        <!-- View Switcher -->
                        
                    </div>
                </div>
            </section>

            <!-- FAQ Records Section -->
            <section class="o_faq_list my-4" t-attf-class="row #{'o_website_grid' if layout_mode == 'grid' else 'o_website_list'}">
                <t t-foreach="records" t-as="record">
                    <div t-attf-class="#{'col-lg-3 col-md-4 col-sm-6' if layout_mode == 'grid' else 'col-12'} mb-3">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title text-primary" t-field="record.x_studio_question"/>
                                <p class="card-text" t-field="record.x_studio_answer"/>
                            </div>
                        </div>
                    </div>
                </t>
            </section>

            <div class="oe_structure oe_new"/>

            <!-- Pagination -->
            <div t-if="pager" class="o_portal_pager d-flex justify-content-center my-4">
                <t t-call="portal.pager"/>
            </div>
        </div>
    </t>
</t>
      </field>
    </record>

  </data>
</odoo>