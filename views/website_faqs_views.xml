<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_8033_default_form_view_for_website_faqs" model="ir.ui.view">
      <field name="name">Default form view for website_faqs</field>
      <field name="model">website_faqs</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form>
  <header/>
  <sheet string="website FAQs">
    <widget name="web_ribbon" text="Archived" bg_color="text-bg-danger" invisible="active"/>
    <field name="active" invisible="1"/>
    <div class="oe_title">
                <h1>
                    <field name="name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_f67068">
      <group name="studio_group_f67068_left"/>
      <group name="studio_group_f67068_right"/>
    </group>
  </sheet>
  <div class="oe_chatter" name="oe_chatter">
    <field name="message_follower_ids"/>
    <field name="message_ids"/>
    <field name="activity_ids"/>
  </div>
</form>
      </field>
    </record>
    <record id="view_8032_default_list_view_for_website_faqs" model="ir.ui.view">
      <field name="name">Default list view for website_faqs</field>
      <field name="model">website_faqs</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree>
  <field name="sequence" widget="handle"/>
  <field name="name"/>
</tree>
      </field>
    </record>
    <record id="view_8034_default_search_view_for_website_faqs" model="ir.ui.view">
      <field name="name">Default search view for website_faqs</field>
      <field name="model">website_faqs</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="name"/>
  <separator/>
  <filter string="Archived" name="archived_website_faqs" domain="[['active', '=', False]]"/>
  <separator/>
</search>
      </field>
    </record>
    <record id="view_8035_odoo_studio_default_form_view_for_x_website_faqs_customizati_ext" model="ir.ui.view">
      <field name="name">Odoo Studio: Default form view for website_faqs customization</field>
      <field name="model">website_faqs</field>
      <field name="type">form</field>
      <field name="inherit_id" ref="BugFix-Studio-Misc.view_8033_default_form_view_for_website_faqs"/>
      <field name="mode">extension</field>
      <field name="priority">99</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//group[@name='studio_group_f67068_left']" position="inside">
    <field name="question"/>
    <field name="answer"/>
  </xpath>
  <xpath expr="//group[@name='studio_group_f67068_right']" position="inside">
    <field name="accounting_active"/>
    <field name="website_published"/>
  </xpath>
</data>
      </field>
    </record>
    <record id="view_8036_odoo_studio_default_list_view_for_x_website_faqs_customizati_ext" model="ir.ui.view">
      <field name="name">Odoo Studio: Default list view for website_faqs customization</field>
      <field name="model">website_faqs</field>
      <field name="type">tree</field>
      <field name="inherit_id" ref="BugFix-Studio-Misc.view_8032_default_list_view_for_website_faqs"/>
      <field name="mode">extension</field>
      <field name="priority">99</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//field[@name='name']" position="replace">
    <field name="answer" optional="show"/>
  </xpath>
  <xpath expr="//field[@name='sequence']" position="before">
    <field name="question" optional="show"/>
  </xpath>
</data>
      </field>
    </record>
  <record id="act_window_3206_website_faqs" model="ir.actions.act_window">
    <field name="name">website FAQs</field>
    <field name="res_model">website_faqs</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
