<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_4883_default_form_view_for_x_test_layout" model="ir.ui.view">
      <field name="name">Default form view for x_test_layout</field>
      <field name="model">x_test_layout</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form>
  <header/>
  <sheet string="Test Layout">
    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
    <field name="x_active" invisible="1"/>
    <div class="oe_title">
                <h1>
                    <field name="x_name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_100598">
      <group name="studio_group_100598_left"/>
      <group name="studio_group_100598_right"/>
    </group>
  </sheet>
  <div class="oe_chatter" name="oe_chatter">
    <!-- STRIPPED field message_follower_ids not on model x_test_layout -->
    <!-- STRIPPED field message_ids not on model x_test_layout -->
    <!-- STRIPPED field activity_ids not on model x_test_layout -->
  </div>
</form>
      </field>
    </record>
    <record id="view_4882_default_list_view_for_x_test_layout" model="ir.ui.view">
      <field name="name">Default list view for x_test_layout</field>
      <field name="model">x_test_layout</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree>
  <field name="x_studio_sequence" widget="handle"/>
  <field name="x_name"/>
</tree>
      </field>
    </record>
    <record id="view_4884_default_search_view_for_x_test_layout" model="ir.ui.view">
      <field name="name">Default search view for x_test_layout</field>
      <field name="model">x_test_layout</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="x_name"/>
  <separator/>
  <filter string="Archived" name="archived_x_test_layout" domain="[['x_active', '=', False]]"/>
  <separator/>
</search>
      </field>
    </record>
    <record id="view_4886_odoo_studio_default_list_view_for_x_test_layout_customizatio_ext" model="ir.ui.view">
      <field name="name">Odoo Studio: Default list view for x_test_layout customization</field>
      <field name="model">x_test_layout</field>
      <field name="type">tree</field>
      <field name="inherit_id" ref="BugFix-Studio-Misc.view_4882_default_list_view_for_x_test_layout"/>
      <field name="mode">extension</field>
      <field name="priority">99</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//tree[1]" position="attributes">
    <attribute name="editable">bottom</attribute>
  </xpath>
  <xpath expr="//field[@name='x_studio_sequence']" position="after">
    <field optional="show" name="x_studio_line_ids" string="Line Ids" column_invisible="1"/>
  </xpath>
  <xpath expr="//field[@name='x_name']" position="attributes">
    <attribute name="column_invisible">1</attribute></xpath>
  <xpath expr="//field[@name='x_name']" position="after">
    <field optional="show" name="x_studio_product_id" string="Product Id"/>
    <field optional="show" name="x_studio_quantity" string="Quantity"/>
  </xpath>
</data>
      </field>
    </record>
  <record id="act_window_2109_test_layout" model="ir.actions.act_window">
    <field name="name">Test Layout</field>
    <field name="res_model">x_test_layout</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
