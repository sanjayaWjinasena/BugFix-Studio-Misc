<?xml version="1.0" encoding="utf-8"?>
<!-- BugFix-Studio-Misc: Phase F7 record rules.
     v124: the global "Employee Expense" and "Employee can't modify expense that is not in draft
     state" copies were removed. Clear-DB has no such rules (only the standard hr_expense rules,
     scoped to Internal User); as global rules they blocked creating expenses (bug sheet 16/Oct). -->
<odoo>
  <record id="rule_f7_hr_expense_hr_expense" model="ir.rule">
    <field name="name">Hr Expense</field>
    <field name="model_id" search="[('model', '=', 'hr.expense')]"/>
    <field name="domain_force">[('create_uid', '=', user.id)]</field>
    <field name="groups" eval="[(6, 0, [ref('account.group_account_readonly')])]"/>
  </record>
</odoo>