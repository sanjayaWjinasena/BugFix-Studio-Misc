<?xml version="1.0" encoding="utf-8"?>
<!-- BugFix-Studio-Misc: Phase F7 - 3 record rules -->
<odoo>
  <record id="rule_f7_hr_expense_employee_expense" model="ir.rule">
    <field name="name">Employee Expense</field>
    <field name="model_id" search="[('model', '=', 'hr.expense')]"/>
    <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
  </record>
  <record id="rule_f7_hr_expense_hr_expense" model="ir.rule">
    <field name="name">Hr Expense</field>
    <field name="model_id" search="[('model', '=', 'hr.expense')]"/>
    <field name="domain_force">[('create_uid', '=', user.id)]</field>
  </record>
  <record id="rule_f7_hr_expense_employee_can_t_modify_expense_that_is_not_in_draft_state" model="ir.rule">
    <field name="name">Employee can't modify expense that is not in draft state</field>
    <field name="model_id" search="[('model', '=', 'hr.expense')]"/>
    <field name="domain_force">[('employee_id.user_id', '=', user.id), ('state', '!=', 'draft')]</field>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>
</odoo>