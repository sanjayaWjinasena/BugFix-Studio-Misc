<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-10-13: move three home-screen tiles into Purchase > Imports.
     The menus belong to BugFix-Accounting / BugFix-Stock, which load before this
     module, so they cannot point at Purchase > Imports (defined here); the parent
     is set here instead. If only BugFix-Accounting / BugFix-Stock is upgraded,
     upgrade this module too or the tiles come back. -->
<odoo>
  <record id="BugFix-Accounting.menu_785_tp_invoice_line" model="ir.ui.menu">
    <field name="parent_id" ref="menu_f6r3_purchase_imports"/>
  </record>
  <record id="BugFix-Stock.menu_f6_temp_consignment_header" model="ir.ui.menu">
    <field name="parent_id" ref="menu_f6r3_purchase_imports"/>
  </record>
  <record id="BugFix-Stock.menu_778_temp_consignment_line" model="ir.ui.menu">
    <field name="parent_id" ref="menu_f6r3_purchase_imports"/>
  </record>
</odoo>
